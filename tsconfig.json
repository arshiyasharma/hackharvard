{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noUncheckedIndexedAccess": true,
    "types": ["bun-types"],
    "paths": {
      "@elves/shared": ["./packages/shared/src/index.ts"],
      "@elves/photon": ["./packages/photon/src/index.ts"],
      "@elves/pipeline": ["./packages/pipeline/src/index.ts"],
      "@elves/llm": ["./packages/llm/src/index.ts"],
      "@elves/elves": ["./packages/elves/src/index.ts"]
    }
  },
  "include": ["apps/**/*.ts", "packages/**/*.ts", "scripts/**/*.ts"],
  "exclude": ["node_modules"]
}
