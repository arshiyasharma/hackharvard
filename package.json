{
  "name": "elves",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run --watch apps/elves/src/index.ts",
    "start": "bun run apps/elves/src/index.ts",
    "demo": "bun run scripts/demo.ts",
    "eval:onboarding": "bun run scripts/onboarding-eval.ts",
    "photon": "bun run scripts/photon.ts",
    "mock-call": "bun run scripts/mock-call.ts",
    "browser": "bun run scripts/browser.ts",
    "test": "bun test",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "db": "bun run scripts/db.ts",
    "test:pg": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://postgres:elves@localhost:54329/postgres} bun test",
    "test:money-pg": "MONEY_TEST_PG=1 TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://postgres:elves@localhost:54329/postgres} bun test packages/money-elf"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@types/bun": "^1.2.0",
    "typescript": "^5.9.0"
  }
}
