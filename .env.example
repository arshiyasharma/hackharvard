# Photon 2.0 project (app.beta.photon.codes -> project -> API keys)
PHOTON_PROJECT_ID=
PHOTON_API_KEY=pho_sk_...
# inbound mode: poll (default, works anywhere) or socket (Socket.IO event stream)
PHOTON_INBOUND=poll
PHOTON_POLL_MS=1500

# Claude (optional for the MVP; without it the Crew Lead uses deterministic replies)
ANTHROPIC_API_KEY=
ELVES_LLM=claude            # claude | fake
ELVES_MODEL_FAST=claude-haiku-5-5
ELVES_MODEL_SMART=claude-sonnet-5-5

# Service
PORT=8787
PUBLIC_URL=http://localhost:8787
ELVES_TRANSPORT=photon2     # photon2 | script
ELVES_STORE=memory          # memory
ELVES_DEBOUNCE_MS=1200
LOG_LEVEL=info
