# Photon 2.0 project (app.beta.photon.codes -> project -> API keys)
PHOTON_PROJECT_ID=
PHOTON_API_KEY=pho_sk_...
# inbound mode: poll (default, works anywhere) or socket (Socket.IO event stream)
PHOTON_INBOUND=poll
PHOTON_POLL_MS=1500

# Claude (optional for the MVP; without it the Crew Lead uses deterministic replies)
ANTHROPIC_API_KEY=
ELVES_LLM=claude            # claude | fake
ELVES_MODEL_FAST=claude-haiku-5-5
ELVES_MODEL_SMART=claude-sonnet-5-5

# Durable state + memory (Postgres). With Supabase use the IPv4 session pooler:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# ELVES_STORE: auto (Postgres when the URL is set and reachable, else in-memory with a warning) | postgres | memory
ELVES_DATABASE_URL=
ELVES_STORE=auto
ELVES_DB_POOL=5
# ELVES_DB_MIGRATE=0 skips the boot-time migration (run `bun run db migrate` yourself)
# Conversational memory: on (default) | off. Transcript window and its token budget:
ELVES_MEMORY=on
ELVES_MEMORY_MESSAGES=24
ELVES_MEMORY_BUDGET=1400

# Housing search (Home Elf): Stagehand v4 browser automation.
# ELVES_BROWSER: browserbase (hosted Chrome; prod) | local (your Chrome; dev) | off (fixtures). ELVES_LISTINGS=fake forces fixtures.
ELVES_BROWSER=off
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
# From `bun run browser login`: the persisted context holding the owner's Facebook login. Unset = Facebook Marketplace is skipped.
BROWSERBASE_CONTEXT_ID=
# Model for page extraction (uses ANTHROPIC_API_KEY); defaults to the fast model
STAGEHAND_MODEL=anthropic/claude-haiku-5-5
# Site allowlist; add booking,apartments,sparefoot,zillow,facebook once `bun run browser search` passes for this deployment
ELVES_LISTINGS_SITES=craigslist,airbnb
ELVES_LISTINGS_SITE_TIMEOUT_MS=45000
ELVES_LISTINGS_TOTAL_TIMEOUT_MS=120000
ELVES_LISTINGS_CONCURRENCY=2
# local mode only
ELVES_BROWSER_USER_DATA_DIR=.data/browser
ELVES_BROWSER_HEADLESS=true

# Service
PORT=8787
PUBLIC_URL=http://localhost:8787
ELVES_TRANSPORT=photon2     # photon2 | script
ELVES_DEBOUNCE_MS=1200
LOG_LEVEL=info
